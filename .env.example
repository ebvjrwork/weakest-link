# Copy this file to .env (which is gitignored) and fill in real values
# before running `docker compose up -d`.

# The domain Caddy will request a Let's Encrypt certificate for. It must
# already resolve (A/AAAA record) to this server's public IP before the
# first start, since Let's Encrypt's HTTP-01 challenge needs to reach port 80.
DOMAIN=chain.example.com

# Bcrypt-hashed into the database on first boot only, then ignored on every
# later boot. Log in with this once, then rotate it (see README) and you can
# remove this line afterward.
ADMIN_BOOTSTRAP_PASSWORD=changeme-please

# Signs the admin session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SIGNING_KEY=
